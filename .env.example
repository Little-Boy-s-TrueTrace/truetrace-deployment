# ==============================================
# TrueTrace Platform - Environment Configuration
# ==============================================

# --- PostgreSQL ---
POSTGRES_DB=truetrace
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production

# --- JWT ---
JWT_SECRET=truetrace-jwt-secret-change-in-production
JWT_EXPIRATION=86400000

# --- Kafka ---
KAFKA_CLUSTER_ID=TrueTraceKafkaCluster001

# --- Nginx ---
NGINX_PORT=80

# --- Vision API (Agent 1: Deepfake Inspector) ---
# Providers: mock, alibaba, azure
VISION_API_PROVIDER=mock
VISION_API_KEY=
VISION_API_ENDPOINT=

# --- LLM (Agent 3: AML Report Generator) ---
# Providers: mock, bedrock, dashscope, openai
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=qwen-plus

# --- Agent Thresholds ---
MONEY_TRAIL_FREEZE_THRESHOLD=7.0
MONEY_TRAIL_WINDOW_SECONDS=600
