# ==============================================
# TrueTrace Platform - Environment Configuration
# ==============================================

# --- PostgreSQL ---
POSTGRES_DB=truetrace
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production

# --- JWT ---
JWT_SECRET=truetrace-jwt-secret-change-in-production
JWT_EXPIRATION=86400000
TRUETRACE_SECURITY_SYNC_TOKEN=change_me_internal_service_token

# --- Kafka ---
KAFKA_CLUSTER_ID=TrueTraceKafkaCluster001

# --- Nginx ---
NGINX_PORT=80

# --- Vision API (Agent 1: Deepfake Inspector) ---
# Providers: demo, alibaba-model-studio, alibaba-ekyc
VISION_API_PROVIDER=demo
VISION_API_KEY=
VISION_API_ENDPOINT=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen-vl-plus
# Assumed national identity API; leave empty for the documented demo format check.
IDENTITY_REGISTRY_ENDPOINT=
IDENTITY_REGISTRY_API_KEY=

# --- LLM (Agent 3: AML Report Generator) ---
# Providers: demo, dashscope
LLM_PROVIDER=demo
LLM_API_KEY=
LLM_MODEL=qwen-plus
LLM_API_ENDPOINT=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# --- Agent Thresholds ---
MONEY_TRAIL_FREEZE_THRESHOLD=7.0
MONEY_TRAIL_WINDOW_SECONDS=60
FAN_OUT_MIN_TARGETS=20
RAPID_MOVEMENT_MIN_INFLOW_VND=1000000000
RAPID_MOVEMENT_RATIO=0.80
